generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogoPdf {
  id          String   @id
  titulo      String
  descripcion String
  precio      Float
  linkDrive   String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  imagenUrl   String?
}

model AccesoRecursos {
  id                    Int                    @id @default(autoincrement())
  enlace_id             Int
  usuario_id            Int
  estado                EstadoAcceso           @default(pendiente)
  fecha_solicitud       DateTime?              @default(now()) @db.Timestamp(0)
  fecha_actualizacion   DateTime?              @default(now()) @db.Timestamp(0)
  enlace_recurso        EnlaceRecurso          @relation(fields: [enlace_id], references: [id], onDelete: Cascade)
  usuario               Usuario                @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pago_acceso_recurso   PagoAccesoRecursos?

  @@unique([usuario_id, enlace_id])
  @@index([enlace_id])
  @@index([estado])
  @@index([usuario_id])
  @@map("accesos_recursos")
}

model ActualizacionCampana {
  id             Int      @id @default(autoincrement())
  campana_id     Int
  autor_id       Int
  titulo         String   @db.VarChar(200)
  contenido      String
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now()) @db.Timestamp(0)
  autor          Usuario  @relation(fields: [autor_id], references: [id], onDelete: NoAction)
  campana        Campana  @relation(fields: [campana_id], references: [id], onDelete: Cascade)

  @@index([campana_id])
  @@map("actualizaciones_campana")
}

model Aviso {
  id                Int             @id @default(autoincrement())
  titulo            String          @db.VarChar(200)
  contenido         String
  tipo              TipoAviso?      @default(informativo)
  destinatario      Destinatario?   @default(clientes)
  link_externo      String?         @db.VarChar(500)
  activo            Boolean?        @default(true)
  fecha_publicacion DateTime?       @default(now()) @db.Timestamp(0)
  fecha_expiracion  DateTime?       @db.Timestamp(0)
  creado_por        Int
  actualizado_por   Int?
  actualizador      Usuario?        @relation("AvisosActualizados", fields: [actualizado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creador           Usuario         @relation("AvisosCreados", fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avisos_leidos     AvisoLeido[]

  @@index([activo])
  @@index([actualizado_por])
  @@index([creado_por])
  @@index([destinatario])
  @@index([fecha_publicacion])
  @@map("avisos")
}

model AvisoLeido {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  aviso_id    Int
  fecha_leido DateTime? @default(now()) @db.Timestamp(0)
  aviso       Aviso     @relation(fields: [aviso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, aviso_id])
  @@index([aviso_id])
  @@index([usuario_id])
  @@map("avisos_leidos")
}

model Campana {
  id                      Int                       @id @default(autoincrement())
  titulo                  String                    @db.VarChar(200)
  descripcion             String?
  historia                String?
  meta_recaudacion        Decimal                   @db.Decimal(14, 2)
  monto_recaudado         Decimal?                  @default(0.00) @db.Decimal(14, 2)
  fecha_inicio            DateTime?                 @db.Date
  fecha_cierre            DateTime?                 @db.Date
  estado                  EstadoCampana?            @default(en_revision)
  activo                  Boolean?                  @default(true)
  negocio_id              Int
  creado_por              Int
  fecha_creacion          DateTime?                 @default(now()) @db.Timestamp(0)
  fecha_actualizacion     DateTime?                 @default(now()) @db.Timestamp(0)
  tipo_crowdfunding       TipoCrowdfunding          @default(donativo)
  interes_pct             Decimal?                  @db.Decimal(5, 2)
  plazo_retorno_dias      Int?
  imagen_url              String?                   @db.VarChar(500)
  video_url               String?                   @db.VarChar(500)
  actualizaciones         ActualizacionCampana[]
  creador                 Usuario                   @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocio                 Negocio                   @relation(fields: [negocio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inversiones             Inversion[]

  @@index([activo])
  @@index([creado_por])
  @@index([estado])
  @@index([negocio_id])
  @@map("campanas")
}

model CategoriaNegocio {
  id             Int         @id @default(autoincrement())
  nombre         String      @unique @db.VarChar(100)
  descripcion    String?
  activo         Boolean?    @default(true)
  fecha_creacion DateTime?   @default(now()) @db.Timestamp(0)
  negocios       Negocio[]
  programas      Programa[]

  @@index([activo])
  @@map("categorias_negocio")
}

model Contacto {
  id                  Int       @id @default(autoincrement())
  telefono            String?   @db.VarChar(20)
  email               String?   @db.VarChar(150)
  direccion           String?
  horario_atencion    String?   @db.VarChar(200)
  whatsapp            String?   @db.VarChar(20)
  facebook_url        String?   @db.VarChar(300)
  instagram_url       String?   @db.VarChar(300)
  linkedin_url        String?   @db.VarChar(300)
  sitio_web           String?   @db.VarChar(300)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(0)

  @@map("contacto_capyme")
}

model Curso {
  id                  Int                   @id @default(autoincrement())
  titulo              String                @db.VarChar(200)
  descripcion         String?
  instructor          String?               @db.VarChar(150)
  duracion_horas      Int?
  modalidad           Modalidad?            @default(online)
  fecha_inicio        DateTime?             @db.Date
  fecha_fin           DateTime?             @db.Date
  cupo_maximo         Int?
  costo               Decimal?              @default(0.00) @db.Decimal(10, 2)
  activo              Boolean?              @default(true)
  creado_por          Int
  fecha_creacion      DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime?             @default(now()) @db.Timestamp(0)
  creador             Usuario               @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripciones       InscripcionCurso[]

  @@index([activo])
  @@index([creado_por])
  @@index([fecha_inicio, fecha_fin])
  @@map("cursos")
}

model EnlaceRecurso {
  id               Int                @id @default(autoincrement())
  titulo           String             @db.VarChar(200)
  descripcion      String?
  url              String             @db.VarChar(500)
  tipo             TipoRecurso?       @default(otro)
  categoria        String?            @db.VarChar(100)
  visible_para     VisiblePara?       @default(todos)
  activo           Boolean?           @default(true)
  costo            Decimal?           @default(0.00) @db.Decimal(10, 2)
  creado_por       Int
  fecha_creacion   DateTime?          @default(now()) @db.Timestamp(0)
  formato          String             @default("video")
  imagenUrl        String?
  imagenPublicId   String?
  accesos          AccesoRecursos[]
  creador          Usuario            @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activo])
  @@index([categoria])
  @@index([creado_por])
  @@index([tipo])
  @@map("enlaces_recursos")
}

model InscripcionCurso {
  id                Int                @id @default(autoincrement())
  curso_id          Int
  usuario_id        Int
  negocio_id        Int?
  fecha_inscripcion DateTime?          @default(now()) @db.Timestamp(0)
  estado            EstadoInscripcion? @default(inscrito)
  calificacion      Int?
  comentarios       String?
  curso             Curso              @relation(fields: [curso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  negocio           Negocio?           @relation(fields: [negocio_id], references: [id], onUpdate: NoAction)
  usuario           Usuario            @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pago_inscripcion  PagoInscripcion?

  @@unique([usuario_id, curso_id])
  @@index([curso_id])
  @@index([estado])
  @@index([negocio_id])
  @@index([usuario_id])
  @@map("inscripciones_curso")
}

model Inversion {
  id                  Int        @id @default(autoincrement())
  campana_id          Int
  inversor_id         Int
  monto               Decimal    @db.Decimal(14, 2)
  referencia          String     @unique @db.VarChar(30)
  tipo_pago           String     @default("electronico") @db.VarChar(20)
  estado_pago         EstadoPago @default(pendiente)
  comprobante         String?    @db.VarChar(500)
  notas               String?
  activo              Boolean?   @default(true)
  mercado_pago_id     String?    @unique @db.VarChar(100)
  url_pago            String?    @db.VarChar(500)
  fecha_pago          DateTime?  @db.Timestamp(0)
  confirmado_por      Int?
  fecha_confirmacion  DateTime?  @db.Timestamp(0)
  fecha_creacion      DateTime?  @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime?  @default(now()) @db.Timestamp(0)
  campana             Campana    @relation(fields: [campana_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  confirmador         Usuario?   @relation("InversionesConfirmadas", fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inversor            Usuario    @relation("InversionesRealizadas", fields: [inversor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([campana_id])
  @@index([estado_pago])
  @@index([inversor_id])
  @@index([mercado_pago_id])
  @@map("inversiones")
}

model JovenJcf {
  id                 Int                   @id @default(autoincrement())
  nombre             String                @db.VarChar(100)
  apellido           String                @db.VarChar(100)
  correo             String?               @db.VarChar(150)
  telefono           String?               @db.VarChar(20)
  curp               String?               @unique @db.VarChar(18)
  negocio_id         Int?
  fecha_inicio       DateTime?             @db.Date
  fecha_termino      DateTime?             @db.Date
  url_recurso        String?               @db.VarChar(500)
  activo             Boolean?              @default(true)
  usuario_id         Int
  postulacion_id     Int?
  fecha_registro     DateTime?             @default(now()) @db.Timestamp(0)
  estatus            String?               @default("Por registrar") @db.VarChar(50)
  tarjeta_entregada  Boolean?              @default(false)
  horarios           String?               @db.VarChar(255)
  horario_confirmado Boolean?              @default(false)
  encargado_id       Int?
  estado_kanban      EstadoPostulacionJcf? @default(PENDIENTE)
  nombreCompleto     String?
  linkPapeles        String?
  credencialesJcf    String?
  nombreNegocio      String?
  linkImagenNegocio  String?
  encargadoId        Int?
  encargado          Usuario?              @relation("JovenesEncargados", fields: [encargadoId], references: [id])
  encargado_original Usuario?              @relation("JovenesEncargadosOriginal", fields: [encargado_id], references: [id], onUpdate: NoAction)
  negocio            Negocio?              @relation(fields: [negocio_id], references: [id], onUpdate: NoAction)
  postulacion        Postulacion?          @relation(fields: [postulacion_id], references: [id], onUpdate: NoAction)
  usuario            Usuario               @relation("JovenesUsuarios", fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([encargado_id])
  @@index([negocio_id])
  @@index([postulacion_id])
  @@index([usuario_id])
  @@map("jovenes_jcf")
}

model Negocio {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  nombre_negocio      String                @db.VarChar(200)
  categoria_id        Int
  rfc                 String?               @db.VarChar(13)
  razon_social        String?               @db.VarChar(200)
  giro_comercial      String?               @db.VarChar(150)
  direccion           String?
  ciudad              String?               @db.VarChar(100)
  estado              String?               @db.VarChar(100)
  codigo_postal       String?               @db.VarChar(10)
  telefono_negocio    String?               @db.VarChar(20)
  email_negocio       String?               @db.VarChar(150)
  numero_empleados    Int?                  @default(0)
  anio_fundacion      Int?                  @db.SmallInt
  descripcion         String?
  activo              Boolean?              @default(true)
  fecha_registro      DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime?             @default(now()) @db.Timestamp(0)
  folio               String?               @db.VarChar(100)
  campanas            Campana[]
  inscripciones       InscripcionCurso[]
  jovenes             JovenJcf[]
  categoria           CategoriaNegocio      @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario             Usuario               @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  postulaciones       Postulacion[]

  @@index([activo])
  @@index([categoria_id])
  @@index([nombre_negocio])
  @@index([usuario_id, activo])
  @@index([usuario_id])
  @@map("negocios")
}

model NotaPostulacion {
  id             Int           @id @default(autoincrement())
  postulacion_id Int
  usuario_id     Int
  nota           String
  fecha_creacion DateTime?     @default(now()) @db.Timestamp(0)
  postulacion    Postulacion   @relation(fields: [postulacion_id], references: [id], onDelete: Cascade)
  usuario        Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([postulacion_id])
  @@index([usuario_id])
  @@map("notas_postulacion")
}

model Notificacion {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  tipo           String    @db.VarChar(50)
  titulo         String    @db.VarChar(200)
  mensaje        String
  leida          Boolean   @default(false)
  fecha_creacion DateTime? @default(now()) @db.Timestamp(0)
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leida])
  @@index([usuario_id])
  @@map("notificaciones")
}

model PagoAccesoRecursos {
  id                 Int              @id @default(autoincrement())
  acceso_id          Int              @unique
  referencia         String           @unique @db.VarChar(30)
  monto              Decimal          @db.Decimal(10, 2)
  tipo_pago          TipoPago
  estado_pago        EstadoPago       @default(pendiente)
  mercado_pago_id    String?          @unique @db.VarChar(100)
  confirmado_por     Int?
  fecha_confirmacion DateTime?        @db.Timestamp(0)
  notas              String?
  fecha_creacion     DateTime?        @default(now()) @db.Timestamp(0)
  acceso             AccesoRecursos   @relation(fields: [acceso_id], references: [id], onDelete: Cascade)
  confirmador        Usuario?         @relation(fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([acceso_id])
  @@index([estado_pago])
  @@index([mercado_pago_id])
  @@index([referencia])
  @@map("pagos_acceso_recursos")
}

model PagoInscripcion {
  id                  Int                 @id @default(autoincrement())
  inscripcion_id      Int                 @unique
  referencia          String              @unique @db.VarChar(30)
  monto               Decimal             @db.Decimal(10, 2)
  tipo_pago           TipoPago
  estado_pago         EstadoPago          @default(pendiente)
  mercado_pago_id     String?             @unique @db.VarChar(100)
  confirmado_por      Int?
  fecha_confirmacion  DateTime?           @db.Timestamp(0)
  notas               String?
  fecha_creacion      DateTime?           @default(now()) @db.Timestamp(0)
  confirmador         Usuario?            @relation(fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripcion         InscripcionCurso    @relation(fields: [inscripcion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([confirmado_por])
  @@index([estado_pago])
  @@index([inscripcion_id])
  @@index([mercado_pago_id])
  @@index([referencia])
  @@map("pagos_inscripcion")
}

model Postulacion {
  id                     Int                      @id @default(autoincrement())
  negocio_id             Int
  programa_id            Int
  usuario_id             Int
  estado                 EstadoPostulacion?       @default(pendiente)
  fecha_postulacion      DateTime?                @default(now()) @db.Timestamp(0)
  fecha_actualizacion    DateTime?                @default(now()) @db.Timestamp(0)
  notas_admin            String?
  estado_geo             String?                  @db.VarChar(100)
  municipio              String?                  @db.VarChar(150)
  jovenes_jcf            JovenJcf[]
  notas                  NotaPostulacion[]
  negocio                Negocio                  @relation(fields: [negocio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programa               Programa                 @relation(fields: [programa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario                Usuario                  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  respuestas             RespuestaPostulacion[]
  trabajadores           TrabajadorJcf[]

  @@unique([negocio_id, programa_id])
  @@index([estado, fecha_postulacion])
  @@index([estado])
  @@index([fecha_postulacion])
  @@index([negocio_id])
  @@index([programa_id])
  @@index([usuario_id])
  @@map("postulaciones")
}

model PreguntaFormulario {
  id                     Int                      @id @default(autoincrement())
  pregunta               String
  tipo_respuesta         TipoRespuesta
  opciones_respuesta     Json?
  obligatoria            Boolean?                 @default(false)
  orden                  Int?                     @default(0)
  categoria              String?                  @db.VarChar(100)
  placeholder            String?                  @db.VarChar(200)
  activa                 Boolean?                 @default(true)
  creado_por             Int
  fecha_creacion         DateTime?                @default(now()) @db.Timestamp(0)
  creador                Usuario                  @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programas              ProgramaPregunta[]
  respuestas             RespuestaPostulacion[]

  @@index([activa])
  @@index([categoria])
  @@index([creado_por])
  @@index([orden])
  @@map("preguntas_formulario")
}

model Programa {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @db.VarChar(200)
  descripcion          String?
  tipo_programa        String?               @db.VarChar(100)
  categoria_negocio_id Int?
  requisitos           String?
  beneficios           String?
  fecha_inicio         DateTime?             @db.Date
  fecha_cierre         DateTime?             @db.Date
  monto_apoyo          Decimal?              @db.Decimal(12, 2)
  activo               Boolean?              @default(true)
  creado_por           Int
  fecha_creacion       DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion  DateTime?             @default(now()) @db.Timestamp(0)
  estado               String?               @db.VarChar(100)
  municipio            String?               @db.VarChar(150)
  postulaciones        Postulacion[]
  categoria            CategoriaNegocio?     @relation(fields: [categoria_negocio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creador              Usuario               @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preguntas            ProgramaPregunta[]

  @@index([activo, categoria_negocio_id])
  @@index([activo])
  @@index([categoria_negocio_id])
  @@index([creado_por])
  @@index([fecha_inicio, fecha_cierre])
  @@map("programas")
}

model ProgramaPregunta {
  id                   Int                  @id @default(autoincrement())
  programa_id          Int
  pregunta_id          Int
  orden                Int?                 @default(0)
  activa               Boolean?             @default(true)
  fecha_asignacion     DateTime?            @default(now()) @db.Timestamp(0)
  pregunta             PreguntaFormulario   @relation(fields: [pregunta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programa             Programa             @relation(fields: [programa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([programa_id, pregunta_id])
  @@index([orden])
  @@index([pregunta_id])
  @@index([programa_id])
  @@map("programas_preguntas")
}

model RespuestaPostulacion {
  id                   Int                  @id @default(autoincrement())
  postulacion_id       Int
  pregunta_id          Int
  respuesta            String?
  fecha_respuesta      DateTime?            @default(now()) @db.Timestamp(0)
  postulacion          Postulacion          @relation(fields: [postulacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pregunta             PreguntaFormulario   @relation(fields: [pregunta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([postulacion_id])
  @@index([pregunta_id])
  @@map("respuestas_postulacion")
}

model TrabajadorJcf {
  id              Int           @id @default(autoincrement())
  postulacion_id  Int
  nombre          String        @db.VarChar(100)
  apellido        String        @db.VarChar(100)
  curp            String?       @unique @db.VarChar(18)
  edad            Int?
  sexo            Sexo?
  telefono        String?       @db.VarChar(20)
  email           String?       @db.VarChar(150)
  nivel_estudios  String?       @db.VarChar(100)
  area_formacion  String?       @db.VarChar(150)
  fecha_inicio    DateTime?     @db.Date
  fecha_fin       DateTime?     @db.Date
  horas_semanales Int?          @default(30)
  tutor_asignado  String?       @db.VarChar(150)
  activo          Boolean?      @default(true)
  fecha_registro  DateTime?     @default(now()) @db.Timestamp(0)
  postulacion     Postulacion   @relation(fields: [postulacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([postulacion_id])
  @@map("trabajadores_jcf")
}

model Usuario {
  id                                               Int                       @id @default(autoincrement())
  nombre                                           String                    @db.VarChar(100)
  apellido                                         String                    @db.VarChar(100)
  email                                            String                    @unique @db.VarChar(150)
  password                                         String                    @db.VarChar(255)
  telefono                                         String?                   @db.VarChar(20)
  rol                                              Rol
  activo                                           Boolean?                  @default(true)
  fecha_registro                                   DateTime?                 @default(now()) @db.Timestamp(0)
  ultima_sesion                                    DateTime?                 @db.Timestamp(0)
  
  accesos_recursos                                 AccesoRecursos[]
  actualizaciones_campana                          ActualizacionCampana[]
  avisos_actualizados                              Aviso[]                   @relation("AvisosActualizados")
  avisos_creados                                   Aviso[]                   @relation("AvisosCreados")
  avisos_leidos                                    AvisoLeido[]
  campanas                                         Campana[]
  cursos                                           Curso[]
  enlaces_recursos                                 EnlaceRecurso[]
  inscripciones_curso                              InscripcionCurso[]
