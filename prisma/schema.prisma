generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogoPdf {
  id          String   @id
  titulo      String
  descripcion String
  precio      Float
  linkDrive   String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  imagenUrl   String?
}

model AccesoRecurso {
  id                  Int          @id @default(autoincrement())
  enlaceId            Int          @map("enlace_id")
  usuarioId           Int          @map("usuario_id")
  estado              EstadoAcceso @default(pendiente)
  fechaSolicitud      DateTime?    @map("fecha_solicitud") @default(now()) @db.Timestamp(0)
  fechaActualizacion  DateTime?    @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  
  enlace_recurso      EnlaceRecurso @relation(fields: [enlaceId], references: [id], onDelete: Cascade)
  usuario             Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pago_acceso_recurso PagoAccesoRecurso?

  @@unique([usuarioId, enlaceId])
  @@index([enlaceId])
  @@index([estado])
  @@index([usuarioId])
  @@map("accesos_recursos")
}

model ActualizacionCampana {
  id             Int      @id @default(autoincrement())
  campanaId      Int      @map("campana_id")
  autorId        Int      @map("autor_id")
  titulo         String   @db.VarChar(200)
  contenido      String
  activo         Boolean  @default(true)
  fechaCreacion  DateTime @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  autor          Usuario  @relation(fields: [autorId], references: [id], onDelete: NoAction)
  campana        Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)

  @@index([campanaId])
  @@map("actualizaciones_campana")
}

model Aviso {
  id               Int           @id @default(autoincrement())
  titulo           String        @db.VarChar(200)
  contenido        String
  tipo             TipoAviso?    @default(informativo)
  destinatario     Destinatario? @default(clientes)
  linkExterno      String?       @map("link_externo") @db.VarChar(500)
  activo           Boolean?      @default(true)
  fechaPublicacion DateTime?     @map("fecha_publicacion") @default(now()) @db.Timestamp(0)
  fechaExpiracion  DateTime?     @map("fecha_expiracion") @db.Timestamp(0)
  creadoPor        Int           @map("creado_por")
  actualizadoPor   Int?          @map("actualizado_por")
  
  actualizador     Usuario?      @relation("avisos_actualizado_porTousuarios", fields: [actualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creador          Usuario       @relation("avisos_creado_porTousuarios", fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avisos_leidos    AvisoLeido[]

  @@index([activo])
  @@index([actualizadoPor])
  @@index([creadoPor])
  @@index([destinatario])
  @@index([fechaPublicacion])
  @@map("avisos")
}

model AvisoLeido {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  avisoId     Int       @map("aviso_id")
  fechaLeido  DateTime? @map("fecha_leido") @default(now()) @db.Timestamp(0)
  
  aviso       Aviso     @relation(fields: [avisoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuarioId, avisoId])
  @@index([avisoId])
  @@index([usuarioId])
  @@map("avisos_leidos")
}

model Campana {
  id                      Int                       @id @default(autoincrement())
  titulo                  String                    @db.VarChar(200)
  descripcion             String?
  historia                String?
  metaRecaudacion         Decimal                   @map("meta_recaudacion") @db.Decimal(14, 2)
  montoRecaudado          Decimal?                  @map("monto_recaudado") @default(0.00) @db.Decimal(14, 2)
  fechaInicio             DateTime?                 @map("fecha_inicio") @db.Date
  fechaCierre             DateTime?                 @map("fecha_cierre") @db.Date
  estado                  EstadoCampana?            @default(en_revision)
  activo                  Boolean?                  @default(true)
  negocioId               Int                       @map("negocio_id")
  creadoPor               Int                       @map("creado_por")
  fechaCreacion           DateTime?                 @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  fechaActualizacion      DateTime?                 @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  tipoCrowdfunding        TipoCrowdfunding          @map("tipo_crowdfunding") @default(donativo)
  interesPct              Decimal?                  @map("interes_pct") @db.Decimal(5, 2)
  plazoRetornoDias        Int?                      @map("plazo_retorno_dias")
  imagenUrl               String?                   @map("imagen_url") @db.VarChar(500)
  videoUrl                String?                   @map("video_url") @db.VarChar(500)
  
  actualizaciones_campana ActualizacionCampana[]
  creador                 Usuario                   @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocio                 Negocio                   @relation(fields: [negocioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inversiones             Inversion[]

  @@index([activo])
  @@index([creadoPor])
  @@index([estado])
  @@index([negocioId])
  @@map("campanas")
}

model CategoriaNegocio {
  id             Int         @id @default(autoincrement())
  nombre         String      @unique @db.VarChar(100)
  descripcion    String?
  activo         Boolean?    @default(true)
  fechaCreacion  DateTime?   @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  negocios       Negocio[]
  programas      Programa[]

  @@index([activo])
  @@map("categorias_negocio")
}

model ContactoCapyme {
  id                  Int       @id @default(autoincrement())
  telefono            String?   @db.VarChar(20)
  email               String?   @db.VarChar(150)
  direccion           String?
  horarioAtencion     String?   @map("horario_atencion") @db.VarChar(200)
  whatsapp            String?   @db.VarChar(20)
  facebookUrl         String?   @map("facebook_url") @db.VarChar(300)
  instagramUrl        String?   @map("instagram_url") @db.VarChar(300)
  linkedinUrl         String?   @map("linkedin_url") @db.VarChar(300)
  sitioWeb            String?   @map("sitio_web") @db.VarChar(300)
  fechaActualizacion  DateTime? @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)

  @@map("contacto_capyme")
}

model Curso {
  id                  Int                   @id @default(autoincrement())
  titulo              String                @db.VarChar(200)
  descripcion         String?
  instructor          String?               @db.VarChar(150)
  duracionHoras       Int?                  @map("duracion_horas")
  modalidad           Modalidad?            @default(online)
  fechaInicio         DateTime?             @map("fecha_inicio") @db.Date
  fechaFin            DateTime?             @map("fecha_fin") @db.Date
  cupoMaximo          Int?                  @map("cupo_maximo")
  costo               Decimal?              @default(0.00) @db.Decimal(10, 2)
  activo              Boolean?              @default(true)
  creadoPor           Int                   @map("creado_por")
  fechaCreacion       DateTime?             @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  fechaActualizacion  DateTime?             @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  
  creador             Usuario               @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripciones_curso InscripcionCurso[]

  @@index([activo])
  @@index([creadoPor])
  @@index([fechaInicio, fechaFin])
  @@map("cursos")
}

model EnlaceRecurso {
  id               Int                @id @default(autoincrement())
  titulo           String             @db.VarChar(200)
  descripcion      String?
  url              String             @db.VarChar(500)
  tipo             TipoRecurso?       @default(otro)
  categoria        String?            @db.VarChar(100)
  visiblePara      VisiblePara?       @map("visible_para") @default(todos)
  activo           Boolean?           @default(true)
  costo            Decimal?           @default(0.00) @db.Decimal(10, 2)
  creadoPor        Int                @map("creado_por")
  fechaCreacion    DateTime?          @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  formato          String             @default("video")
  imagenUrl        String?
  imagenPublicId   String?
  
  accesos_recursos AccesoRecurso[]
  creador          Usuario            @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activo])
  @@index([categoria])
  @@index([creadoPor])
  @@index([tipo])
  @@map("enlaces_recursos")
}

model InscripcionCurso {
  id                Int                @id @default(autoincrement())
  cursoId           Int                @map("curso_id")
  usuarioId         Int                @map("usuario_id")
  negocioId         Int?               @map("negocio_id")
  fechaInscripcion  DateTime?          @map("fecha_inscripcion") @default(now()) @db.Timestamp(0)
  estado            EstadoInscripcion? @default(inscrito)
  calificacion      Int?
  comentarios       String?
  
  curso             Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  negocio           Negocio?           @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pago_inscripcion  PagoInscripcion?

  @@unique([usuarioId, cursoId])
  @@index([cursoId])
  @@index([estado])
  @@index([negocioId])
  @@index([usuarioId])
  @@map("inscripciones_curso")
}

model Inversion {
  id                  Int        @id @default(autoincrement())
  campanaId           Int        @map("campana_id")
  inversorId          Int        @map("inversor_id")
  monto               Decimal    @db.Decimal(14, 2)
  referencia          String     @unique @db.VarChar(30)
  tipoPago            String     @map("tipo_pago") @default("electronico") @db.VarChar(20)
  estadoPago          EstadoPago @map("estado_pago") @default(pendiente)
  comprobante         String?    @db.VarChar(500)
  notas               String?
  activo              Boolean?   @default(true)
  mercadoPagoId       String?    @map("mercado_pago_id") @unique @db.VarChar(100)
  urlPago             String?    @map("url_pago") @db.VarChar(500)
  fechaPago           DateTime?  @map("fecha_pago") @db.Timestamp(0)
  confirmadoPor       Int?       @map("confirmado_por")
  fechaConfirmacion   DateTime?  @map("fecha_confirmacion") @db.Timestamp(0)
  fechaCreacion       DateTime?  @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  fechaActualizacion  DateTime?  @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  
  campana             Campana    @relation(fields: [campanaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  confirmador         Usuario?   @relation("inversiones_confirmado_porTousuarios", fields: [confirmadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inversor            Usuario    @relation("inversiones_inversor_idTousuarios", fields: [inversorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([campanaId])
  @@index([estadoPago])
  @@index([inversorId])
  @@index([mercadoPagoId])
  @@map("inversiones")
}

model JovenJcf {
  id                 Int                   @id @default(autoincrement())
  nombre             String                @db.VarChar(100)
  apellido           String                @db.VarChar(100)
  correo             String?               @db.VarChar(150)
  telefono           String?               @db.VarChar(20)
  curp               String?               @unique @db.VarChar(18)
  negocioId          Int?                  @map("negocio_id")
  fechaInicio        DateTime?             @map("fecha_inicio") @db.Date
  fechaTermino       DateTime?             @map("fecha_termino") @db.Date
  urlRecurso         String?               @map("url_recurso") @db.VarChar(500)
  activo             Boolean?              @default(true)
  usuarioId          Int                   @map("usuario_id")
  postulacionId      Int?                  @map("postulacion_id")
  fechaRegistro      DateTime?             @map("fecha_registro") @default(now()) @db.Timestamp(0)
  estatus            String?               @default("Por registrar") @db.VarChar(50)
  tarjetaEntregada   Boolean?              @map("tarjeta_entregada") @default(false)
  horarios           String?               @db.VarChar(255)
  horarioConfirmado  Boolean?              @map("horario_confirmado") @default(false)
  encargadoIdLegacy  Int?                  @map("encargado_id")
  estadoKanban       EstadoPostulacionJcf? @map("estado_kanban") @default(PENDIENTE)
  
  nombreCompleto     String?
  linkPapeles        String?
  credencialesJcf    String?
  nombreNegocio      String?
  linkImagenNegocio  String?
  encargadoId        Int?

  encargado          Usuario?              @relation("jovenes_jcf_encargadoIdTousuarios", fields: [encargadoId], references: [id])
  encargado_original Usuario?              @relation("jovenes_jcf_encargado_idTousuarios", fields: [encargadoIdLegacy], references: [id], onUpdate: NoAction)
  negocio            Negocio?              @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  postulacion        Postulacion?          @relation(fields: [postulacionId], references: [id], onUpdate: NoAction)
  usuario            Usuario               @relation("jovenes_jcf_usuario_idTousuarios", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([encargadoIdLegacy])
  @@index([negocioId])
  @@index([postulacionId])
  @@index([usuarioId])
  @@map("jovenes_jcf")
}

model Negocio {
  id                  Int                   @id @default(autoincrement())
  usuarioId           Int                   @map("usuario_id")
  nombreNegocio       String                @map("nombre_negocio") @db.VarChar(200)
  categoriaId         Int                   @map("categoria_id")
  rfc                 String?               @db.VarChar(13)
  razonSocial         String?               @map("razon_social") @db.VarChar(200)
  giroComercial       String?               @map("giro_comercial") @db.VarChar(150)
  direccion           String?
  ciudad              String?               @db.VarChar(100)
  estado              String?               @db.VarChar(100)
  codigoPostal        String?               @map("codigo_postal") @db.VarChar(10)
  telefonoNegocio     String?               @map("telefono_negocio") @db.VarChar(20)
  emailNegocio        String?               @map("email_negocio") @db.VarChar(150)
  numeroEmpleados     Int?                  @map("numero_empleados") @default(0)
  anioFundacion       Int?                  @map("anio_fundacion") @db.SmallInt
  descripcion         String?
  activo              Boolean?              @default(true)
  fechaRegistro       DateTime?             @map("fecha_registro") @default(now()) @db.Timestamp(0)
  fechaActualizacion  DateTime?             @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  folio               String?               @db.VarChar(100)
  
  campanas            Campana[]
  inscripciones_curso InscripcionCurso[]
  jovenes_jcf         JovenJcf[]
  categoria           CategoriaNegocio      @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario             Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  postulaciones       Postulacion[]

  @@index([activo])
  @@index([categoriaId])
  @@index([nombreNegocio])
  @@index([usuarioId, activo])
  @@index([usuarioId])
  @@map("negocios")
}

model NotaPostulacion {
  id             Int           @id @default(autoincrement())
  postulacionId  Int           @map("postulacion_id")
  usuarioId      Int           @map("usuario_id")
  nota           String
  fechaCreacion  DateTime?     @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  postulacion    Postulacion   @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([postulacionId])
  @@index([usuarioId])
  @@map("notas_postulacion")
}

model Notificacion {
  id             Int       @id @default(autoincrement())
  usuarioId      Int       @map("usuario_id")
  tipo           String    @db.VarChar(50)
  titulo         String    @db.VarChar(200)
  mensaje        String
  leida          Boolean   @default(false)
  fechaCreacion  DateTime? @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leida])
  @@index([usuarioId])
  @@map("notificaciones")
}

model PagoAccesoRecurso {
  id                 Int              @id @default(autoincrement())
  accesoId           Int              @map("acceso_id") @unique
  referencia         String           @unique @db.VarChar(30)
  monto              Decimal          @db.Decimal(10, 2)
  tipoPago           TipoPago         @map("tipo_pago")
  estadoPago         EstadoPago       @map("estado_pago") @default(pendiente)
  mercadoPagoId      String?          @map("mercado_pago_id") @unique @db.VarChar(100)
  confirmadoPor      Int?             @map("confirmado_por")
  fechaConfirmacion  DateTime?        @map("fecha_confirmacion") @db.Timestamp(0)
  notas              String?
  fechaCreacion      DateTime?        @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  acceso_recurso     AccesoRecurso    @relation(fields: [accesoId], references: [id], onDelete: Cascade)
  confirmador        Usuario?         @relation(fields: [confirmadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accesoId])
  @@index([estadoPago])
  @@index([mercadoPagoId])
  @@index([referencia])
  @@map("pagos_acceso_recursos")
}

model PagoInscripcion {
  id                  Int                 @id @default(autoincrement())
  inscripcionId       Int                 @map("inscripcion_id") @unique
  referencia          String              @unique @db.VarChar(30)
  monto               Decimal             @db.Decimal(10, 2)
  tipoPago            TipoPago            @map("tipo_pago")
  estadoPago          EstadoPago          @map("estado_pago") @default(pendiente)
  mercadoPagoId       String?             @map("mercado_pago_id") @unique @db.VarChar(100)
  confirmadoPor       Int?                @map("confirmado_por")
  fechaConfirmacion   DateTime?           @map("fecha_confirmacion") @db.Timestamp(0)
  notas               String?
  fechaCreacion       DateTime?           @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  confirmador         Usuario?            @relation(fields: [confirmadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripcion_curso   InscripcionCurso    @relation(fields: [inscripcionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([confirmadoPor])
  @@index([estadoPago])
  @@index([inscripcionId])
  @@index([mercadoPagoId])
  @@index([referencia])
  @@map("pagos_inscripcion")
}

model Postulacion {
  id                     Int                      @id @default(autoincrement())
  negocioId              Int                      @map("negocio_id")
  programaId             Int                      @map("programa_id")
  usuarioId              Int                      @map("usuario_id")
  estado                 EstadoPostulacion?       @default(pendiente)
  fechaPostulacion       DateTime?                @map("fecha_postulacion") @default(now()) @db.Timestamp(0)
  fechaActualizacion     DateTime?                @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  notasAdmin             String?                  @map("notas_admin")
  estadoGeo              String?                  @map("estado_geo") @db.VarChar(100)
  municipio              String?                  @db.VarChar(150)
  
  jovenes_jcf            JovenJcf[]
  notas_postulacion      NotaPostulacion[]
  negocio                Negocio                  @relation(fields: [negocioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programa               Programa                 @relation(fields: [programaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario                Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  respuestas_postulacion RespuestaPostulacion[]
  trabajadores_jcf       TrabajadorJcf[]

  @@unique([negocioId, programaId])
  @@index([estado, fechaPostulacion])
  @@index([estado])
  @@index([fechaPostulacion])
  @@index([negocioId])
  @@index([programaId])
  @@index([usuarioId])
  @@map("postulaciones")
}

model PreguntaFormulario {
  id                     Int                      @id @default(autoincrement())
  pregunta               String
  tipoRespuesta          TipoRespuesta            @map("tipo_respuesta")
  opcionesRespuesta      Json?                    @map("opciones_respuesta")
  obligatoria            Boolean?                 @default(false)
  orden                  Int?                     @default(0)
  categoria              String?                  @db.VarChar(100)
  placeholder            String?                  @db.VarChar(200)
  activa                 Boolean?                 @default(true)
  creadoPor              Int                      @map("creado_por")
  fechaCreacion          DateTime?                @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  
  creador                Usuario                  @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programas_preguntas    ProgramaPregunta[]
  respuestas_postulacion RespuestaPostulacion[]

  @@index([activa])
  @@index([categoria])
  @@index([creadoPor])
  @@index([orden])
  @@map("preguntas_formulario")
}

model Programa {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @db.VarChar(200)
  descripcion          String?
  tipoPrograma         String?               @map("tipo_programa") @db.VarChar(100)
  categoriaNegocioId   Int?                  @map("categoria_negocio_id")
  requisitos           String?
  beneficios           String?
  fechaInicio          DateTime?             @map("fecha_inicio") @db.Date
  fechaCierre          DateTime?             @map("fecha_cierre") @db.Date
  montoApoyo           Decimal?              @map("monto_apoyo") @db.Decimal(12, 2)
  activo               Boolean?              @default(true)
  creadoPor            Int                   @map("creado_por")
  fechaCreacion        DateTime?             @map("fecha_creacion") @default(now()) @db.Timestamp(0)
  fechaActualizacion   DateTime?             @map("fecha_actualizacion") @default(now()) @db.Timestamp(0)
  estado               String?               @db.VarChar(100)
  municipio            String?               @db.VarChar(150)
  
  postulaciones        Postulacion[]
  categoria_negocio    CategoriaNegocio?     @relation(fields: [categoriaNegocioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creador              Usuario               @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programas_preguntas  ProgramaPregunta[]

  @@index([activo, categoriaNegocioId])
  @@index([activo])
  @@index([categoriaNegocioId])
  @@index([creadoPor])
  @@index([fechaInicio, fechaCierre])
  @@map("programas")
}

model ProgramaPregunta {
  id                   Int                  @id @default(autoincrement())
  programaId           Int                  @map("programa_id")
  preguntaId           Int                  @map("pregunta_id")
  orden                Int?                 @default(0)
  activa               Boolean?             @default(true)
  fechaAsignacion      DateTime?            @map("fecha_asignacion") @default(now()) @db.Timestamp(0)
  
  pregunta             PreguntaFormulario   @relation(fields: [preguntaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programa             Programa             @relation(fields: [programaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([programaId, preguntaId])
  @@index([orden])
  @@index([preguntaId])
  @@index([programaId])
  @@map("programas_preguntas")
}

model RespuestaPostulacion {
  id                   Int                  @id @default(autoincrement())
  postulacionId        Int                  @map("postulacion_id")
  preguntaId           Int                  @map("pregunta_id")
  respuesta            String?
  fechaRespuesta       DateTime?            @map("fecha_respuesta") @default(now()) @db.Timestamp(0)
  
  postulacion          Postulacion          @relation(fields: [postulacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pregunta             PreguntaFormulario   @relation(fields: [preguntaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([postulacionId])
  @@index([preguntaId])
  @@map("respuestas_postulacion")
}

model TrabajadorJcf {
  id              Int           @id @default(autoincrement())
  postulacionId   Int           @map("postulacion_id")
  nombre          String        @db.VarChar(100)
  apellido        String        @db.VarChar(100)
  curp            String?       @unique @db.VarChar(18)
  edad            Int?
  sexo            Sexo?
  telefono        String?       @db.VarChar(20)
  email           String?       @db.VarChar(150)
  nivelEstudios   String?       @map("nivel_estudios") @db.VarChar(100)
  areaFormacion   String?       @map("area_formacion") @db.VarChar(150)
  fechaInicio     DateTime?     @map("fecha_inicio") @db.Date
  fechaFin        DateTime?     @map("fecha_fin") @db.Date
  horasSemanales  Int?          @map("horas_semanales") @default(30)
  tutorAsignado   String?       @map("tutor_asignado") @db.VarChar(150)
  activo          Boolean?      @default(true)
  fechaRegistro   DateTime?     @map("fecha_registro") @default(now()) @db.Timestamp(0)
  
  postulacion     Postulacion   @relation(fields: [postulacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([postulacionId])
  @@map("trabajadores_jcf")
}

model Usuario {
  id                                               Int                       @id @default(autoincrement())
  nombre                                           String                    @db.VarChar(100)
  apellido                                         String                    @db.VarChar(100)
  email                                            String                    @unique @db.VarChar(150)
  password                                         String                    @db.VarChar(255)
  telefono                                         String?                   @db.VarChar(20)
  rol                                              Rol
  activo                                           Boolean?                  @default(true)
  fechaRegistro                                    DateTime?                 @map("fecha_registro") @default(now()) @db.Timestamp(0)
  ultimaSesion                                     DateTime?                 @map("ultima_sesion") @db.Timestamp(0)
  
  accesos_recursos                                 AccesoRecurso[]
  actualizaciones_campana                          ActualizacionCampana[]
  avisos_actualizados                              Aviso[]                   @relation("avisos_actualizado_porTousuarios")
  avisos_creados                                   Aviso[]                   @relation("avisos_creado_porTousuarios")
  avisos_leidos                                    AvisoLeido[]
  campanas                                         Campana[]
  cursos                                           Curso[]
  enlaces_recursos                                 EnlaceRecurso[]
  inscripciones_curso                              InscripcionCurso[]
  inversiones_confirmadas                          Inversion[]               @relation("inversiones_confirmado_porTousuarios")
  inversiones_realizadas                           Inversion[]               @relation("inversiones_inversor_idTousuarios")
  jovenes_encargados                               JovenJcf[]                @relation("jovenes_jcf_encargadoIdTousuarios")
  jovenes_encargados_original                      JovenJcf[]                @relation("jovenes_jcf_encargado_idTousuarios")
  jovenes_usuarios                                 JovenJcf[]                @relation("jovenes_jcf_usuario_idTousuarios")
  negocios                                         Negocio[]
  notas_postulacion                                NotaPostulacion[]
  notificaciones                                   Notificacion[]
  pagos_acceso_recursos                            PagoAccesoRecurso[]
  pagos_inscripcion                                PagoInscripcion[]
  postulaciones                                    Postulacion[]
  preguntas_formulario                             PreguntaFormulario[]
  programas                                        Programa[]

  @@index([activo])
  @@index([email])
  @@index([rol])
  @@map("usuarios")
}

