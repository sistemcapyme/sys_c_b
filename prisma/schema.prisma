generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogoPdf {
  id          String   @id
  titulo      String
  descripcion String
  precio      Float
  linkDrive   String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  imagenUrl   String?
}

model accesos_recursos {
  id                    Int                    @id @default(autoincrement())
  enlace_id             Int
  usuario_id            Int
  estado                EstadoAcceso           @default(pendiente)
  fecha_solicitud       DateTime?              @default(now()) @db.Timestamp(0)
  fecha_actualizacion   DateTime?              @default(now()) @db.Timestamp(0)
  enlaces_recursos      enlaces_recursos       @relation(fields: [enlace_id], references: [id], onDelete: Cascade)
  usuarios              usuarios               @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pagos_acceso_recursos pagos_acceso_recursos?

  @@unique([usuario_id, enlace_id])
  @@index([enlace_id])
  @@index([estado])
  @@index([usuario_id])
}

model actualizaciones_campana {
  id             Int      @id @default(autoincrement())
  campana_id     Int
  autor_id       Int
  titulo         String   @db.VarChar(200)
  contenido      String
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now()) @db.Timestamp(0)
  usuarios       usuarios @relation(fields: [autor_id], references: [id], onDelete: NoAction)
  campanas       campanas @relation(fields: [campana_id], references: [id], onDelete: Cascade)

  @@index([campana_id])
}

model avisos {
  id                                        Int             @id @default(autoincrement())
  titulo                                    String          @db.VarChar(200)
  contenido                                 String
  tipo                                      TipoAviso?      @default(informativo)
  destinatario                              Destinatario?   @default(clientes)
  link_externo                              String?         @db.VarChar(500)
  activo                                    Boolean?        @default(true)
  fecha_publicacion                         DateTime?       @default(now()) @db.Timestamp(0)
  fecha_expiracion                          DateTime?       @db.Timestamp(0)
  creado_por                                Int
  actualizado_por                           Int?
  usuarios_avisos_actualizado_porTousuarios usuarios?       @relation("avisos_actualizado_porTousuarios", fields: [actualizado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_avisos_creado_porTousuarios      usuarios        @relation("avisos_creado_porTousuarios", fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avisos_leidos                             avisos_leidos[]

  @@index([activo])
  @@index([actualizado_por])
  @@index([creado_por])
  @@index([destinatario])
  @@index([fecha_publicacion])
}

model avisos_leidos {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  aviso_id    Int
  fecha_leido DateTime? @default(now()) @db.Timestamp(0)
  avisos      avisos    @relation(fields: [aviso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios    usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, aviso_id])
  @@index([aviso_id])
  @@index([usuario_id])
}

model campanas {
  id                      Int                       @id @default(autoincrement())
  titulo                  String                    @db.VarChar(200)
  descripcion             String?
  historia                String?
  meta_recaudacion        Decimal                   @db.Decimal(14, 2)
  monto_recaudado         Decimal?                  @default(0.00) @db.Decimal(14, 2)
  fecha_inicio            DateTime?                 @db.Date
  fecha_cierre            DateTime?                 @db.Date
  estado                  EstadoCampana?            @default(en_revision)
  activo                  Boolean?                  @default(true)
  negocio_id              Int
  creado_por              Int
  fecha_creacion          DateTime?                 @default(now()) @db.Timestamp(0)
  fecha_actualizacion     DateTime?                 @default(now()) @db.Timestamp(0)
  tipo_crowdfunding       TipoCrowdfunding          @default(donativo)
  interes_pct             Decimal?                  @db.Decimal(5, 2)
  plazo_retorno_dias      Int?
  imagen_url              String?                   @db.VarChar(500)
  video_url               String?                   @db.VarChar(500)
  actualizaciones_campana actualizaciones_campana[]
  usuarios                usuarios                  @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocios                negocios                  @relation(fields: [negocio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inversiones             inversiones[]

  @@index([activo])
  @@index([creado_por])
  @@index([estado])
  @@index([negocio_id])
}

model categorias_negocio {
  id             Int         @id @default(autoincrement())
  nombre         String      @unique @db.VarChar(100)
  descripcion    String?
  activo         Boolean?    @default(true)
  fecha_creacion DateTime?   @default(now()) @db.Timestamp(0)
  negocios       negocios[]
  programas      programas[]

  @@index([activo])
}

model contacto_capyme {
  id                  Int       @id @default(autoincrement())
  telefono            String?   @db.VarChar(20)
  email               String?   @db.VarChar(150)
  direccion           String?
  horario_atencion    String?   @db.VarChar(200)
  whatsapp            String?   @db.VarChar(20)
  facebook_url        String?   @db.VarChar(300)
  instagram_url       String?   @db.VarChar(300)
  linkedin_url        String?   @db.VarChar(300)
  sitio_web           String?   @db.VarChar(300)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(0)
}

model cursos {
  id                  Int                   @id @default(autoincrement())
  titulo              String                @db.VarChar(200)
  descripcion         String?
  instructor          String?               @db.VarChar(150)
  duracion_horas      Int?
  modalidad           Modalidad?            @default(online)
  fecha_inicio        DateTime?             @db.Date
  fecha_fin           DateTime?             @db.Date
  cupo_maximo         Int?
  costo               Decimal?              @default(0.00) @db.Decimal(10, 2)
  activo              Boolean?              @default(true)
  creado_por          Int
  fecha_creacion      DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime?             @default(now()) @db.Timestamp(0)
  usuarios            usuarios              @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripciones_curso inscripciones_curso[]

  @@index([activo])
  @@index([creado_por])
  @@index([fecha_inicio, fecha_fin])
}

model enlaces_recursos {
  id               Int                @id @default(autoincrement())
  titulo           String             @db.VarChar(200)
  descripcion      String?
  url              String             @db.VarChar(500)
  tipo             TipoRecurso?       @default(otro)
  categoria        String?            @db.VarChar(100)
  visible_para     VisiblePara?       @default(todos)
  activo           Boolean?           @default(true)
  costo            Decimal?           @default(0.00) @db.Decimal(10, 2)
  creado_por       Int
  fecha_creacion   DateTime?          @default(now()) @db.Timestamp(0)
  formato          String             @default("video")
  imagenUrl        String?
  imagenPublicId   String?
  accesos_recursos accesos_recursos[]
  usuarios         usuarios           @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activo])
  @@index([categoria])
  @@index([creado_por])
  @@index([tipo])
}

model inscripciones_curso {
  id                Int                @id @default(autoincrement())
  curso_id          Int
  usuario_id        Int
  negocio_id        Int?
  fecha_inscripcion DateTime?          @default(now()) @db.Timestamp(0)
  estado            EstadoInscripcion? @default(inscrito)
  calificacion      Int?
  comentarios       String?
  cursos            cursos             @relation(fields: [curso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  negocios          negocios?          @relation(fields: [negocio_id], references: [id], onUpdate: NoAction)
  usuarios          usuarios           @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pagos_inscripcion pagos_inscripcion?

  @@unique([usuario_id, curso_id])
  @@index([curso_id])
  @@index([estado])
  @@index([negocio_id])
  @@index([usuario_id])
}

model inversiones {
  id                                            Int        @id @default(autoincrement())
  campana_id                                    Int
  inversor_id                                   Int
  monto                                         Decimal    @db.Decimal(14, 2)
  referencia                                    String     @unique @db.VarChar(30)
  tipo_pago                                     String     @default("electronico") @db.VarChar(20)
  estado_pago                                   EstadoPago @default(pendiente)
  comprobante                                   String?    @db.VarChar(500)
  notas                                         String?
  activo                                        Boolean?   @default(true)
  mercado_pago_id                               String?    @unique @db.VarChar(100)
  url_pago                                      String?    @db.VarChar(500)
  fecha_pago                                    DateTime?  @db.Timestamp(0)
  confirmado_por                                Int?
  fecha_confirmacion                            DateTime?  @db.Timestamp(0)
  fecha_creacion                                DateTime?  @default(now()) @db.Timestamp(0)
  fecha_actualizacion                           DateTime?  @default(now()) @db.Timestamp(0)
  campanas                                      campanas   @relation(fields: [campana_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios_inversiones_confirmado_porTousuarios usuarios?  @relation("inversiones_confirmado_porTousuarios", fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_inversiones_inversor_idTousuarios    usuarios   @relation("inversiones_inversor_idTousuarios", fields: [inversor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([campana_id])
  @@index([estado_pago])
  @@index([inversor_id])
  @@index([mercado_pago_id])
}

model jovenes_jcf {
  id                                          Int                   @id @default(autoincrement())
  nombre                                      String                @db.VarChar(100)
  apellido                                    String                @db.VarChar(100)
  correo                                      String?               @db.VarChar(150)
  telefono                                    String?               @db.VarChar(20)
  curp                                        String?               @unique @db.VarChar(18)
  negocio_id                                  Int?
  fecha_inicio                                DateTime?             @db.Date
  fecha_termino                               DateTime?             @db.Date
  url_recurso                                 String?               @db.VarChar(500)
  activo                                      Boolean?              @default(true)
  usuario_id                                  Int
  postulacion_id                              Int?
  fecha_registro                              DateTime?             @default(now()) @db.Timestamp(0)
  estatus                                     String?               @default("Por registrar") @db.VarChar(50)
  tarjeta_entregada                           Boolean?              @default(false)
  horarios                                    String?               @db.VarChar(255)
  horario_confirmado                          Boolean?              @default(false)
  encargado_id                                Int?
  estado_kanban                               EstadoPostulacionJcf? @default(PENDIENTE)
  nombreCompleto                              String?
  linkPapeles                                 String?
  credencialesJcf                             String?
  nombreNegocio                               String?
  linkImagenNegocio                           String?
  encargadoId                                 Int?
  usuarios_jovenes_jcf_encargadoIdTousuarios  usuarios?             @relation("jovenes_jcf_encargadoIdTousuarios", fields: [encargadoId], references: [id])
  usuarios_jovenes_jcf_encargado_idTousuarios usuarios?             @relation("jovenes_jcf_encargado_idTousuarios", fields: [encargado_id], references: [id], onUpdate: NoAction)
  negocios                                    negocios?             @relation(fields: [negocio_id], references: [id], onUpdate: NoAction)
  postulaciones                               postulaciones?        @relation(fields: [postulacion_id], references: [id], onUpdate: NoAction)
  usuarios_jovenes_jcf_usuario_idTousuarios   usuarios              @relation("jovenes_jcf_usuario_idTousuarios", fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([encargado_id])
  @@index([negocio_id])
  @@index([postulacion_id])
  @@index([usuario_id])
}

model negocios {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  nombre_negocio      String                @db.VarChar(200)
  categoria_id        Int
  rfc                 String?               @db.VarChar(13)
  razon_social        String?               @db.VarChar(200)
  giro_comercial      String?               @db.VarChar(150)
  direccion           String?
  ciudad              String?               @db.VarChar(100)
  estado              String?               @db.VarChar(100)
  codigo_postal       String?               @db.VarChar(10)
  telefono_negocio    String?               @db.VarChar(20)
  email_negocio       String?               @db.VarChar(150)
  numero_empleados    Int?                  @default(0)
  anio_fundacion      Int?                  @db.SmallInt
  descripcion         String?
  activo              Boolean?              @default(true)
  fecha_registro      DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime?             @default(now()) @db.Timestamp(0)
  folio               String?               @db.VarChar(100)
  campanas            campanas[]
  inscripciones_curso inscripciones_curso[]
  jovenes_jcf         jovenes_jcf[]
  categorias_negocio  categorias_negocio    @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios            usuarios              @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  postulaciones       postulaciones[]

  @@index([activo])
  @@index([categoria_id])
  @@index([nombre_negocio])
  @@index([usuario_id, activo])
  @@index([usuario_id])
}

model notas_postulacion {
  id             Int           @id @default(autoincrement())
  postulacion_id Int
  usuario_id     Int
  nota           String
  fecha_creacion DateTime?     @default(now()) @db.Timestamp(0)
  postulaciones  postulaciones @relation(fields: [postulacion_id], references: [id], onDelete: Cascade)
  usuarios       usuarios      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([postulacion_id])
  @@index([usuario_id])
}

model notificaciones {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  tipo           String    @db.VarChar(50)
  titulo         String    @db.VarChar(200)
  mensaje        String
  leida          Boolean   @default(false)
  fecha_creacion DateTime? @default(now()) @db.Timestamp(0)
  usuarios       usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leida])
  @@index([usuario_id])
}

model pagos_acceso_recursos {
  id                 Int              @id @default(autoincrement())
  acceso_id          Int              @unique
  referencia         String           @unique @db.VarChar(30)
  monto              Decimal          @db.Decimal(10, 2)
  tipo_pago          TipoPago
  estado_pago        EstadoPago       @default(pendiente)
  mercado_pago_id    String?          @unique @db.VarChar(100)
  confirmado_por     Int?
  fecha_confirmacion DateTime?        @db.Timestamp(0)
  notas              String?
  fecha_creacion     DateTime?        @default(now()) @db.Timestamp(0)
  accesos_recursos   accesos_recursos @relation(fields: [acceso_id], references: [id], onDelete: Cascade)
  usuarios           usuarios?        @relation(fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([acceso_id])
  @@index([estado_pago])
  @@index([mercado_pago_id])
  @@index([referencia])
}

model pagos_inscripcion {
  id                  Int                 @id @default(autoincrement())
  inscripcion_id      Int                 @unique
  referencia          String              @unique @db.VarChar(30)
  monto               Decimal             @db.Decimal(10, 2)
  tipo_pago           TipoPago
  estado_pago         EstadoPago          @default(pendiente)
  mercado_pago_id     String?             @unique @db.VarChar(100)
  confirmado_por      Int?
  fecha_confirmacion  DateTime?           @db.Timestamp(0)
  notas               String?
  fecha_creacion      DateTime?           @default(now()) @db.Timestamp(0)
  usuarios            usuarios?           @relation(fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscripciones_curso inscripciones_curso @relation(fields: [inscripcion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([confirmado_por])
  @@index([estado_pago])
  @@index([inscripcion_id])
  @@index([mercado_pago_id])
  @@index([referencia])
}

model postulaciones {
  id                     Int                      @id @default(autoincrement())
  negocio_id             Int
  programa_id            Int
  usuario_id             Int
  estado                 EstadoPostulacion?       @default(pendiente)
  fecha_postulacion      DateTime?                @default(now()) @db.Timestamp(0)
  fecha_actualizacion    DateTime?                @default(now()) @db.Timestamp(0)
  notas_admin            String?
  estado_geo             String?                  @db.VarChar(100)
  municipio              String?                  @db.VarChar(150)
  jovenes_jcf            jovenes_jcf[]
  notas_postulacion      notas_postulacion[]
  negocios               negocios                 @relation(fields: [negocio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programas              programas                @relation(fields: [programa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios               usuarios                 @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  respuestas_postulacion respuestas_postulacion[]
  trabajadores_jcf       trabajadores_jcf[]

  @@unique([negocio_id, programa_id])
  @@index([estado, fecha_postulacion])
  @@index([estado])
  @@index([fecha_postulacion])
  @@index([negocio_id])
  @@index([programa_id])
  @@index([usuario_id])
}

model preguntas_formulario {
  id                     Int                      @id @default(autoincrement())
  pregunta               String
  tipo_respuesta         TipoRespuesta
  opciones_respuesta     Json?
  obligatoria            Boolean?                 @default(false)
  orden                  Int?                     @default(0)
  categoria              String?                  @db.VarChar(100)
  placeholder            String?                  @db.VarChar(200)
  activa                 Boolean?                 @default(true)
  creado_por             Int
  fecha_creacion         DateTime?                @default(now()) @db.Timestamp(0)
  usuarios               usuarios                 @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programas_preguntas    programas_preguntas[]
  respuestas_postulacion respuestas_postulacion[]

  @@index([activa])
  @@index([categoria])
  @@index([creado_por])
  @@index([orden])
}

model programas {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @db.VarChar(200)
  descripcion          String?
  tipo_programa        String?               @db.VarChar(100)
  categoria_negocio_id Int?
  requisitos           String?
  beneficios           String?
  fecha_inicio         DateTime?             @db.Date
  fecha_cierre         DateTime?             @db.Date
  monto_apoyo          Decimal?              @db.Decimal(12, 2)
  activo               Boolean?              @default(true)
  creado_por           Int
  fecha_creacion       DateTime?             @default(now()) @db.Timestamp(0)
  fecha_actualizacion  DateTime?             @default(now()) @db.Timestamp(0)
  estado               String?               @db.VarChar(100)
  municipio            String?               @db.VarChar(150)
  postulaciones        postulaciones[]
  categorias_negocio   categorias_negocio?   @relation(fields: [categoria_negocio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios             usuarios              @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programas_preguntas  programas_preguntas[]

  @@index([activo, categoria_negocio_id])
  @@index([activo])
  @@index([categoria_negocio_id])
  @@index([creado_por])
  @@index([fecha_inicio, fecha_cierre])
}

model programas_preguntas {
  id                   Int                  @id @default(autoincrement())
  programa_id          Int
  pregunta_id          Int
  orden                Int?                 @default(0)
  activa               Boolean?             @default(true)
  fecha_asignacion     DateTime?            @default(now()) @db.Timestamp(0)
  preguntas_formulario preguntas_formulario @relation(fields: [pregunta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programas            programas            @relation(fields: [programa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([programa_id, pregunta_id])
  @@index([orden])
  @@index([pregunta_id])
  @@index([programa_id])
}

model respuestas_postulacion {
  id                   Int                  @id @default(autoincrement())
  postulacion_id       Int
  pregunta_id          Int
  respuesta            String?
  fecha_respuesta      DateTime?            @default(now()) @db.Timestamp(0)
  postulaciones        postulaciones        @relation(fields: [postulacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preguntas_formulario preguntas_formulario @relation(fields: [pregunta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([postulacion_id])
  @@index([pregunta_id])
}

model trabajadores_jcf {
  id              Int           @id @default(autoincrement())
  postulacion_id  Int
  nombre          String        @db.VarChar(100)
  apellido        String        @db.VarChar(100)
  curp            String?       @unique @db.VarChar(18)
  edad            Int?
  sexo            Sexo?
  telefono        String?       @db.VarChar(20)
  email           String?       @db.VarChar(150)
  nivel_estudios  String?       @db.VarChar(100)
  area_formacion  String?       @db.VarChar(150)
  fecha_inicio    DateTime?     @db.Date
  fecha_fin       DateTime?     @db.Date
  horas_semanales Int?          @default(30)
  tutor_asignado  String?       @db.VarChar(150)
  activo          Boolean?      @default(true)
  fecha_registro  DateTime?     @default(now()) @db.Timestamp(0)
  postulaciones   postulaciones @relation(fields: [postulacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo])
  @@index([postulacion_id])
}

model usuarios {
  id                                               Int                       @id @default(autoincrement())
  nombre                                           String                    @db.VarChar(100)
  apellido                                         String                    @db.VarChar(100)
  email                                            String                    @unique @db.VarChar(150)
  password                                         String                    @db.VarChar(255)
  telefono                                         String?                   @db.VarChar(20)
  rol                                              Rol
  activo                                           Boolean?                  @default(true)
  fecha_registro                                   DateTime?                 @default(now()) @db.Timestamp(0)
  ultima_sesion                                    DateTime?                 @db.Timestamp(0)
  accesos_recursos                                 accesos_recursos[]
  actualizaciones_campana                          actualizaciones_campana[]
  avisos_avisos_actualizado_porTousuarios          avisos[]                  @relation("avisos_actualizado_porTousuarios")
  avisos_avisos_creado_porTousuarios               avisos[]                  @relation("avisos_creado_porTousuarios")
  avisos_leidos                                    avisos_leidos[]
  campanas                                         campanas[]
  cursos                                           cursos[]
